# Copy this file to .env and fill in the blanks. .env is ignored by git.

# Postgres (local, inside Docker)
POSTGRES_USER=collections
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=collections
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM provider (https://console.groq.com)
GROQ_API_KEY=

# Tracing (https://cloud.langfuse.com, EU region)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
